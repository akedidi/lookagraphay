# Base de données (Hostinger / prod)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:5001
# Prod Hostinger : https://blue-squirrel-716769.hostingersite.com
# Webhook Stripe : https://blue-squirrel-716769.hostingersite.com/api/webhook
ADMIN_EMAIL=contact@lookagraphy.fr

# Admin backoffice (/admin) — générer des valeurs fortes :
#   openssl rand -base64 24   → ADMIN_PASSWORD
#   openssl rand -base64 32   → ADMIN_SESSION_SECRET
# Ne jamais committer les vraies valeurs. Régénérer si un ancien mot de passe a fuité.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Santé (/api/health) — en production, requis pour accéder à l'endpoint
#   curl -H "x-health-secret: VOTRE_CLE" https://votre-domaine/api/health
HEALTH_CHECK_SECRET=

# Paiement : paypal | stripe
PAYMENT_PROVIDER=stripe
PAYPAL_EMAIL=lookagraphy

# Stripe — SÉCURITÉ
# - STRIPE_SECRET_KEY et STRIPE_WEBHOOK_SECRET : UNIQUEMENT côté serveur (jamais NEXT_PUBLIC_, jamais dans le code).
# - En prod : variables Hostinger / hPanel, pas de fichier .env sur le serveur public.
# - En local : .env.local uniquement (déjà dans .gitignore). Ne jamais committer de vraies clés.
# - pk_* (publishable) peut être publique si un jour tu utilises Stripe.js côté client ; optionnel avec Checkout hébergé.
# - Avant deploy : npm run check-secrets
STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   # optionnel (Checkout redirect actuel n'en a pas besoin)
STRIPE_WEBHOOK_SECRET=whsec_...

# Gmail API — envoi des emails commande (client + ADMIN_EMAIL)
# 1) Google Cloud : activer Gmail API, OAuth client type "Application Web"
# 2) URI de redirection : {NEXT_PUBLIC_SITE_URL}/auth/google/callback
# 3) Une fois : GET /api/auth/gmail?key=VOTRE_GMAIL_OAUTH_SETUP_KEY → copier GMAIL_REFRESH_TOKEN
# Ne jamais committer client_secret*.json
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=votre-compte@gmail.com
# GMAIL_FROM_NAME=LookaGraphy
# GMAIL_REDIRECT_URI=https://blue-squirrel-716769.hostingersite.com/auth/google/callback
# GMAIL_OAUTH_SETUP_KEY=cle-secrete-pour-lier-gmail-une-fois
