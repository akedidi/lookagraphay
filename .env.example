# Base de données (Hostinger / prod)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Hostinger — sync auto public_html → nodejs/ à chaque npm run build (Passenger).
# Optionnel si le build tourne dans public_html/ (détection ~/domains/…/nodejs).
# HOSTINGER_NODEJS_DIR=/home/u376353647/domains/VOTRE-SITE.hostingersite.com/nodejs

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:5001
# Prod Hostinger : https://blue-squirrel-716769.hostingersite.com
# Webhook Stripe : https://blue-squirrel-716769.hostingersite.com/api/webhook
ADMIN_EMAIL=contact@lookagraphy.fr

# Admin backoffice (/admin) — générer des valeurs fortes :
#   openssl rand -base64 24   → ADMIN_PASSWORD
#   openssl rand -base64 32   → ADMIN_SESSION_SECRET
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

HEALTH_CHECK_SECRET=

PAYMENT_PROVIDER=stripe
PAYPAL_EMAIL=lookagraphy

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Gmail : 2 comptes, 2 clients OAuth, 2 clés setup ────────────────────────
# Même redirect URI : {NEXT_PUBLIC_SITE_URL}/auth/google/callback

# 1) lookagraphy.order — COMMANDES UNIQUEMENT
#    OAuth : /api/auth/gmail?key=VALEUR_DE_GMAIL_OAUTH_SETUP_KEY
GMAIL_OAUTH_SETUP_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=lookagraphy.order@gmail.com
GMAIL_FROM_NAME=LookaGraphy

# 2) contact.lookagraphy — CONTACT + NEWSLETTER UNIQUEMENT
#    OAuth : /api/auth/gmail?key=VALEUR_DE_CONTACT_GMAIL_OAUTH_SETUP_KEY&contact=1
CONTACT_GMAIL_OAUTH_SETUP_KEY=
CONTACT_GMAIL_CLIENT_ID=
CONTACT_GMAIL_CLIENT_SECRET=
CONTACT_GMAIL_REFRESH_TOKEN=
CONTACT_GMAIL_SENDER=contact.lookagraphy@gmail.com
CONTACT_GMAIL_FROM_NAME=LookaGraphy

# GMAIL_REDIRECT_URI=https://blue-squirrel-716769.hostingersite.com/auth/google/callback
